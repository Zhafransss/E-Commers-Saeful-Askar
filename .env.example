APP_NAME="Saeful Askar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e_commers_saeful_askar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@saefulaskar.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# true = frontend answers from resources/js/api/mocks (docs/api examples)
# and Blade pages skip the login guard. Local development only.
VITE_API_MOCK=false

# Initial admin account (AdminUserSeeder). Required outside local.
ADMIN_NAME="Admin Saeful Askar"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Jubelio Omnichannel (config/jubelio.php)
JUBELIO_BASE_URL=https://api2.jubelio.com
JUBELIO_EMAIL=
JUBELIO_PASSWORD=
JUBELIO_STORE_ID=
JUBELIO_LOCATION_ID=
JUBELIO_TAX_ID=
JUBELIO_WEBHOOK_SECRET=
JUBELIO_WEBHOOK_SIGNATURE_HEADER=sign

# Jubelio Shipment (config/jubelio_shipment.php); driver: stub | api
JUBELIO_SHIPMENT_DRIVER=stub
JUBELIO_SHIPMENT_BASE_URL=
JUBELIO_SHIPMENT_CLIENT_ID=
JUBELIO_SHIPMENT_CLIENT_SECRET=
JUBELIO_SHIPMENT_ENV=staging
JUBELIO_SHIPMENT_ORIGIN_SUBDISTRICT_ID=

# Gapura / DANA payment gateway (config/gapura.php, docs/api/integrations.md INT-GP-00)
# Sandbox credentials come from https://dashboard.dana.id/sandbox/ . Keep the private key file out of git.
GAPURA_ENV=sandbox
GAPURA_CLIENT_ID=
GAPURA_MERCHANT_ID=
GAPURA_PRIVATE_KEY_PATH=storage/app/gapura/private_key.pem
# Only needed in production; the SDK has DANA's sandbox key built in.
GAPURA_DANA_PUBLIC_KEY_PATH=
GAPURA_ORIGIN="${APP_URL}"
GAPURA_MCC=
# Public URL DANA posts the payment result to; the path must be /v1.0/debit/notify.
# Empty = APP_URL + that path. Behind a tunnel (ngrok) put the full tunnel URL here.
GAPURA_NOTIFY_URL=
GAPURA_PAYMENT_DURATION=7200
